APP_NAME=Private Notes Service
APP_ENV=development
APP_PORT=8000

POSTGRES_DB=notes
POSTGRES_USER=notes
POSTGRES_PASSWORD=replace_with_a_local_development_password
POSTGRES_PORT=5432

# Used when the application runs directly on the host.
DATABASE_URL=postgresql+psycopg://notes:replace_with_a_local_development_password@localhost:5432/notes

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=false
